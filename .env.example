# AVERO TECHNOLOGIES — Environment template
# Copy to .env.local for local development. Never commit secrets.

NEXT_PUBLIC_SITE_URL=https://avero.tech

CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
NEWSLETTER_RATE_LIMIT_MAX=8
NEWSLETTER_RATE_LIMIT_WINDOW_MS=600000

# Employee portal — real accounts only (no demo users)
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string
PORTAL_ADMIN_EMAIL=you@yourcompany.com
PORTAL_ADMIN_PASSWORD=use-a-strong-unique-password
PORTAL_ADMIN_NAME=Your Name
PORTAL_ADMIN_TITLE=CEO & CTO
PORTAL_ADMIN_DEPARTMENT=Corporate
# Optional: PORTAL_USERS=[{"email":"...","password":"...","name":"...","role":"employee","title":"...","department":"..."}]
